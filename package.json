{
  "name": "murmur-astro-blog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist && node scripts/clean-pagefind-output.ts && node scripts/write-cloudflare-headers.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview": "astro preview",
    "check": "astro check",
    "size": "node scripts/css-size.ts",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.4",
    "@astrojs/mdx": "^8.1.0",
    "astro": "^7.0.0",
    "pagefind": "^1.5.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.5",
    "@types/node": "^22.20.5",
    "typescript": "^5.7.3",
    "wrangler": "4.151.3"
  }
}
