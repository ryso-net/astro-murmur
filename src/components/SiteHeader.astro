---
import { murmurConfig } from "../config";
import SiteSearchDialog from "./SiteSearchDialog.astro";
import SiteNavLinks from "./SiteNavLinks.astro";
import { getMessages, siteLocale } from "../i18n/ui";
import { localePath } from "../utils/paths";

const messages = getMessages();
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const pathFor = (href: string) => new URL(href, Astro.url).pathname.replace(/\/+$/, "") || "/";
const isActive = (href: string) => {
  const path = pathFor(href);
  return currentPath === path || (path !== pathFor(localePath("")) && currentPath.startsWith(`${path}/`));
};
const configuredNavigation = Object.entries(murmurConfig.navigation[siteLocale]);
const routePath = (route: string) => route.replace(/^\/+|\/+$/g, "");
const navItems = configuredNavigation.map(([label, route]) => {
  const href = localePath(route);
  const isArchive = routePath(route) === "archive";
  return {
    label,
    href,
    active: isActive(href) || (isArchive && isActive(localePath("posts"))),
  };
});
---

<header class="site-header">
  <a class="site-brand" href={localePath("")}>{murmurConfig.title}</a>
  <nav class="site-nav" aria-label={messages.navLabel}>
    <SiteNavLinks items={navItems} />
  </nav>
  <div class="site-header-actions">
    <SiteSearchDialog />
    <button
      class="site-header-control theme-toggle"
      type="button"
      data-theme-toggle
      data-theme-current={messages.themeCurrent}
      data-theme-system={messages.themeSystem}
      data-theme-light={messages.themeLight}
      data-theme-dark={messages.themeDark}
      aria-label={messages.themeCurrent.replace("{theme}", messages.themeSystem)}
      title={messages.themeCurrent.replace("{theme}", messages.themeSystem)}
      aria-pressed="mixed"
    >
      <svg class="theme-toggle-icon theme-toggle-icon--system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="4" width="18" height="13" rx="1.5" />
        <path d="M8 21h8m-4-4v4" />
      </svg>
      <svg class="theme-toggle-icon theme-toggle-icon--sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
      </svg>
      <svg class="theme-toggle-icon theme-toggle-icon--moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.2 15.2A8.5 8.5 0 0 1 8.8 3.8 8.6 8.6 0 1 0 20.2 15.2Z" />
      </svg>
    </button>

    <button class="site-header-control site-nav-mobile site-nav-mobile-toggle" type="button" aria-label={messages.navLabel} popovertarget="site-nav-mobile-panel">
      <svg class="site-nav-mobile-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="site-nav-mobile-close-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18" />
      </svg>
    </button>
    <nav class="site-nav-mobile-panel" id="site-nav-mobile-panel" popover="auto" aria-label={messages.navLabel}>
      <SiteNavLinks items={navItems} />
    </nav>
  </div>
</header>
